import { assert, type Equals } from "tsafe";

import type {
{{#each types}}
  {{name}},
{{/each}}
} from "@/fixtures/{{file}}";

{{#each types}}
{{#each comments}}{{.}}
{{/each}}
type {{name}}Flat{{parameters}} = {{text}};

{{/each}}

{{#each types}}
{{#unless skipAssert}}
assert<
  {{#if relaxedAssert}}
    {{name}}Flat{{arguments}} extends {{name}}{{arguments}}
      ? {{name}}{{arguments}} extends {{name}}Flat{{arguments}} ? true : false
      : false
  {{else}}
  Equals<
    {{name}}{{arguments}},
    {{name}}Flat{{arguments}}
  >
  {{/if}}
>;
{{/unless}}
{{/each}}
