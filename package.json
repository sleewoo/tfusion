{
  "type": "module",
  "name": "tfusion",
  "description": "Flatten complex TypeScript types into readable, inspectable plaintext structures",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "author": "Slee Woo",
  "license": "MIT",
  "repository": "https://github.com/sleewoo/tfusion",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "pkg/*"
  ],
  "exports": {
    ".": {
      "types": "./pkg/src/index.d.ts",
      "default": "./pkg/index.js"
    }
  },
  "scripts": {
    "// ✨ build": "",
    "prebuild": "for e in ./scripts/build/*; do sh $e; done",
    "build": "esbuild ./src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=pkg",
    "// ✨ test": "",
    "pretest": "esbuild ./test/factory/run.ts --bundle --platform=node --target=node22 --format=esm --packages=external --loader:.hbs=text --outdir=test",
    "test": "node ./test/run && tsc -p ./test/tsconfig.json",
    "posttest": "rm -fv ./test/run.js*",
    "// ✨ publish": "",
    "prepub": "./scripts/publish/prepare",
    "pub": "pnpm stage publish",
    "pub:tags": "git push --follow-tags"
  },
  "dependencies": {
    "crc": "^4.3.2",
    "handlebars": "^4.7.9",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tinyglobby": "^0.2.17",
    "tsafe": "^1.8.12",
    "typescript": "^7.0.2"
  }
}
